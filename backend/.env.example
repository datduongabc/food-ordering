# local = console email fallback and non-Secure cookies for plain-HTTP dev. Never use on a public server.
APP_ENV=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/food_ordering_db

# Leave empty in local mode to print emails (OTP codes) to the server log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
