# Copy to .env and fill in. docker compose reads this file.

# local = OTP emails in the backend log, MoMo sandbox (unless MoMo keys are set), seeded admin
#         (datduongtandat385@gmail.com / 12345678). production = none of these; needs HTTPS.
APP_ENV=local
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DB_NAME=dateno
DB_USER=postgres
DB_PASSWORD=postgres
# Only needed when the password has characters that must be URL-encoded:
# DATABASE_URL=postgresql+psycopg://USER:ENCODED_PASSWORD@db:5432/dateno

# The app is served at http://localhost:${WEB_PORT}.
WEB_PORT=8000
# The address customers use; MoMo returns them here and posts payment results to it.
PUBLIC_URL=http://localhost:8000

# Live MoMo payments: keys from https://business.momo.vn (Integration > test environment).
# Leave empty to use the built-in sandbox locally. MOMO_ENDPOINT=https://payment.momo.vn
# takes real money. Locally MoMo cannot reach the IPN, so results arrive via the return page.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn

# Leave the username empty to print emails to the backend log instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
